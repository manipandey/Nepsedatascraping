# ====================================================================
# NEPSE TERMINAL - SUPABASE & VERCEL ENVIRONMENT VARIABLES
# Copy these environment variables to Vercel Project Settings -> Environment Variables
# ====================================================================

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (for frontend client queries)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Secret Key (for Python backend sync_to_supabase.py script - KEEP PRIVATE)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
